@{
    Locale locale = (Locale)ViewData["culture"];
    ViewData["Title"] = locale["Title_Syntax"];
    var available = ViewData["ListedTypes"] as (string, string)[];
}
<h1>@ViewData["Title"]</h1>
<p>
    @Html.Raw(locale["Syntax_70OLD"])
</p>
<ul>
    @foreach (var x in available)
    {
        <li><a href="~/@x.Item1">@x.Item2</a></li>
    }
</ul>