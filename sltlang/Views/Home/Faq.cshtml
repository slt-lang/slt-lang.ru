@{
    Locale locale = (Locale)ViewData["culture"];
    ViewData["Title"] = locale["Title_FAQ"];
}
@inject IArticleLogic articleLogic

<h1>Самые популярные статьи</h1>
<p>Список самых популярных статей</p>
<ul>
    @foreach (var article in await articleLogic.GetRating())
    {
        <li><a href="~/@locale.Identifier/articles/@article.Name">@article.Title</a></li>
    }
</ul>