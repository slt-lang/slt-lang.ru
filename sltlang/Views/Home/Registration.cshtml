@using Microsoft.AspNetCore.Http.Extensions
@model RegistrationModel
@{
    Locale locale = (Locale)ViewData["culture"];
    ViewData["Title"] = locale["Title_Registration"];
    var authed = Context.User.Identity.IsAuthenticated;
}
<h1>@ViewData["Title"]</h1>
@if (authed)
{
    <p>@(string.Format(locale["RegPage_ThanksForRegistration"], Context.User.Identity.Name))</p>
    <form action="~/api/Auth/logout" method="post">
        <input name="redirectUrl" id="redirectUrl" value="/@locale.Identifier/login" hidden />
        <div>
            <a class="button" href="~/@locale.Identifier/profile">@locale["LoginPage_GoToProfile"]</a>
        </div>
        <div>
            <button class="button" type="submit">@locale["LoginPage_Logout"]</button>
        </div>
    </form>
}
else
{
    <form action="~/api/Auth/register" method="post">
        <div>
            <label for="inviteLink">@locale["RegPage_InviteLinkLabel"]</label>
            @if (string.IsNullOrEmpty(Model.Link))
            {
                <input class="input" placeholder="@locale["RegPage_InviteLink"]" name="invite" id="invite" value="" />
            }
            else
            {
                <input class="input" name="invite" id="invite" value="@Model.Link" readonly />
            }
        </div>
        <div>
            <label for="inviteLink">@locale["RegPage_AccessDataLabel"]</label>
            <input class="input" placeholder="@locale["LoginPage_Username"]" name="username" id="username" value="" required maxlength="32" minlength="3" pattern="^[a-zA-Z0-9_]+$" title="@locale["LoginPage_UsernameFilter"]" />
        </div>
        <div>
            <input class="input" placeholder="@locale["LoginPage_Password"]" name="password" id="password" value="" required maxlength="64" minlength="1" />
            <input class="input" placeholder="@locale["RegPage_PasswordConfirm"]" name="passwordConfirm" id="passwordConfirm" value="" required maxlength="64" minlength="1" />
        </div>
        <div>
            <label for="inviteLink">@locale["RegPage_OtherDataLabel"]</label>
            <input class="input" placeholder="@locale["RegPage_DisplayName"]" name="displayName" id="password" value="" required maxlength="32" minlength="1" />
        </div>
        <input name="successRedirectUrl" id="successRedirectUrl" value="/@locale.Identifier/profile" hidden required />
        <input name="failedRedirectUrl" id="failedRedirectUrl" value="/@locale.Identifier/registration@(string.IsNullOrEmpty(Model.Link)?"":$"?invite={Model.Link}")" hidden required />
        <div>
            <button class="button" type="submit">@locale["RegPage_Registration"]</button>
        </div>
    </form>
    @if (Model.Result == "wrong")
    {
        <div style="color: darkred; text-align: center;">
            @locale["LoginPage_WrongAuth"]
        </div>
    }
    @if (Model.Result == "authserviceerror")
    {
        <div style="color: darkred; text-align: center;">
            @locale["LoginPage_AuthServiceError"]
        </div>
    }
    <p style="display: block; text-align: center">@(string.Format(locale["LoginPage_Cookie"], locale["RegPage_Registration"]))</p>
}